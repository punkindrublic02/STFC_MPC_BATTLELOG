{
  "name": "stfc-toolbox",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "local-sync",
    "mcp-server",
    "tools"
  ],
  "license": "MIT",
  "scripts": {
    "start": "webpack serve",
    "serve:web": "node scripts/serve-web.mjs",
    "watch": "webpack --watch",
    "build": "webpack",
    "pretty": "prettier -w src",
    "update:game-data": "node tools/update-game-data.mjs",
    "sync:entities": "node tools/sync-entities-db.mjs",
    "assets:audit": "node tools/import-stfc-assets.mjs --audit",
    "assets:import": "node tools/import-stfc-assets.mjs",
    "import:vger-workbook": "python tools/import-vger-workbook.py",
    "sync:mechanics": "node tools/sync-mechanics-knowledge.mjs",
    "backfill:hostile-matches": "node tools/backfill-hostile-matches.mjs",
    "db:backup": "node tools/maintain-db.mjs --backup-only",
    "db:prune": "node tools/maintain-db.mjs --prune-only",
    "db:maintain": "node tools/maintain-db.mjs",
    "db:maintain:dry-run": "node tools/maintain-db.mjs --dry-run",
    "backfill:parsed-targets": "npm --workspace local-sync run backfill:parsed-targets --",
    "parse:missing": "npm --workspace local-sync run parse:missing --",
    "create:api-client": "npm --workspace local-sync run create:api-client --",
    "dev": "concurrently \"npm run start\" \"npm run dev:api\" \"npm run dev:mcp\"",
    "dev:api": "cd local-sync && npm run dev",
    "dev:mcp": "cd mcp-server && npm run dev"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.8",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@tanstack/react-query": "^5.90.5",
    "d3": "^7.9.0",
    "moment": "^2.30.1",
    "node-fetch": "^3.3.2",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8",
    "react-router-dom": "^7.9.4",
    "react-simple-code-editor": "^0.14.1",
    "react-use-form-state": "^0.13.2",
    "react-virtualized-auto-sizer": "^1.0.26",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.0.1",
    "@types/prismjs": "^1.26.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.1.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "ts-loader": "^9.5.4",
    "typescript": "^6.0.2",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.0.0"
  },
  "overrides": {
    "react-use-form-state": {
      "react": "^19.2.0",
      "react-dom": "^19.2.0"
    }
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.27.7": true
  }
}
