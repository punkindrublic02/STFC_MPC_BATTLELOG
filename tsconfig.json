{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "lib": [ "dom", "dom.iterable", "esnext" ],
    "module": "esnext",
    "moduleResolution": "node", /* Restores the map for your node_modules */
    "baseUrl": ".",
    "paths": {
      "*": [ "src/*", "node_modules/*" ]
    },
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": false,
    "strict": false, /* Temporarily disabling strict to clear those 'err is unknown' and 'any' type blocks */
    "forceConsistentCasingInFileNames": true
  },
  "include": [ "src", "local-sync", "tools" ,"mcp-server"]
}